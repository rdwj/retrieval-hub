# RetrievalHub cluster deployment configuration.
#
# Copy this file to deploy/.env (or any path) and fill in the values.
# Then deploy with:
#
#   make deploy-cluster CONTEXT=<your-context> ENV_FILE=deploy/.env
#
# Lines starting with # are comments. Blank values are optional.

# ---------------------------------------------------------------------------
# Cluster connection
# ---------------------------------------------------------------------------

# OpenShift context name from your kubeconfig (oc config get-contexts).
CONTEXT=gpt-oss-120b

# OpenShift project / namespace. Created if it doesn't exist.
PROJECT=retrieval-hub

# ---------------------------------------------------------------------------
# PostgreSQL
# ---------------------------------------------------------------------------

# Credentials for the catalog and vector databases. Both databases
# run in a single StatefulSet. These are used to create the
# retrieval-hub-pg secret if it doesn't already exist.
POSTGRES_USER=retrievalhub
POSTGRES_PASSWORD=retrievalhub

# ---------------------------------------------------------------------------
# Google OAuth (optional)
# ---------------------------------------------------------------------------

# Enables interactive Google login for MCP clients (Claude Code, etc.).
# Leave blank to skip — the MCP server will still work with machine-to-
# machine JWT tokens from the auth service.
#
# To create these credentials:
#   1. Google Cloud Console > APIs & Services > Credentials
#   2. Create OAuth 2.0 Client ID (Web application)
#   3. Add authorized redirect URI:
#      https://<your-mcp-route>/auth/callback
#
RETRIEVAL_HUB_GOOGLE_CLIENT_ID=
RETRIEVAL_HUB_GOOGLE_CLIENT_SECRET=

# ---------------------------------------------------------------------------
# Auth service signing key
# ---------------------------------------------------------------------------

# Path to a PEM-encoded RSA private key for signing JWTs.
# If blank, the auth service generates an ephemeral key on startup
# (fine for dev/demo, not for production — tokens won't survive restarts).
RETRIEVAL_HUB_AUTH_SIGNING_KEY_PATH=

# ---------------------------------------------------------------------------
# LLM endpoint (for query rewriting and evaluation)
# ---------------------------------------------------------------------------

# The vLLM-compatible endpoint used by the query rewriter and EvalHub.
# Typically an in-cluster service URL. Leave blank if no LLM is available.
LLM_ENDPOINT_URL=
LLM_MODEL_NAME=/mnt/models

# ---------------------------------------------------------------------------
# Derived values (auto-detected if blank)
# ---------------------------------------------------------------------------

# The public HTTPS URL of the MCP server route, without a path.
# Auto-detected from `oc get route retrieval-hub-mcp` after deployment.
# Set this only if you need to override auto-detection.
MCP_ROUTE_URL=

# The base URL for Google OAuth callbacks. Defaults to MCP_ROUTE_URL.
GOOGLE_BASE_URL=
