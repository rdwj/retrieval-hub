FROM registry.redhat.io/ubi9/python-311:latest

WORKDIR /opt/app-root/src

# --- Dependencies -----------------------------------------------------------
# Install all runtime deps up front so Docker layer caching applies when only
# source code changes.  The requirements file pins every direct dep needed by
# both the core library and the MCP server.
COPY requirements-deploy.txt .
RUN pip install --no-cache-dir -r requirements-deploy.txt

# --- Core library (retrieval-hub) -------------------------------------------
COPY --chown=1001:0 core-lib/ ./core-lib/
RUN pip install --no-cache-dir ./core-lib/

# --- MCP server (retrieval-hub-mcp) -----------------------------------------
COPY --chown=1001:0 mcp-server/ ./mcp-server/
RUN pip install --no-cache-dir ./mcp-server/

# --- Prompt templates + scripts ---------------------------------------------
COPY --chown=1001:0 prompts/ ./prompts/
COPY --chown=1001:0 scripts/ ./scripts/

RUN find . -name "*.py" -exec chmod 644 {} \;

# --- Runtime environment ----------------------------------------------------
ENV MCP_TRANSPORT=http \
    MCP_HTTP_HOST=0.0.0.0 \
    MCP_HTTP_PORT=8080

EXPOSE 8080

USER 1001

CMD ["python", "-m", "retrieval_hub_mcp"]
